{
  "name": "dts-wiki-frontend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript http://localhost:8080/v3/api-docs --output src/api/schema.d.ts"
  },
  "dependencies": {
    "@ant-design/icons": "6.0.2",
    "@milkdown/crepe": "^7.22.2",
    "@tanstack/react-query": "5.90.2",
    "antd": "6.6.5",
    "i18next": "25.5.3",
    "markdown-it": "14.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "16.3.3",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/markdown-it": "14.1.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.1",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "vite": "7.2.4",
    "vitest": "3.2.4"
  },
  "engines": {
    "node": "24"
  }
