# Copy to /data/dts-wiki-v2/.env on 10.20.0.50 and fill in. NEVER commit the real file.
# DB password for the wiki database (also used by Liquibase at startup).
WIKI_DB_PASSWORD=change-me
# Obtain the OIDC client secret from the externally managed SSO configuration.
WIKI_OIDC_CLIENT_SECRET=change-me
WIKI_OIDC_ISSUER=https://sso.yuzhicloud.com/realms/yuzhicloud
WIKI_OIDC_CLIENT_ID=dts-wiki
# Image tags written by deploy/release.sh.
APP_TAG=dev
DB_TAG=18-bigm
# Public URL: acceptance http://10.20.0.50:18091, after cutover https://wiki.yuzhicloud.com
WIKI_PUBLIC_URL=http://10.20.0.50:18091
# Content repository; install its read-only deploy key as secrets/content.key (0600).
WIKI_CONTENT_REPO_URL=git@github.com:your-company/your-content-repository.git
WIKI_CONTENT_BRANCH=main
WIKI_CONTENT_MANIFEST_PATH=dts-worklog/spaces.yml
# Externally managed optional legacy aliases and personal MCP endpoint.
WIKI_LEGACY_ALIASES_JSON={}
WIKI_MCP_ENABLED=false
WIKI_MCP_RESOURCE_URI=https://wiki.yuzhicloud.com/mcp
# Read-only identity adapter. Infra provisions the external service credential.
WIKI_DIRECTORY_BASE_URL=
WIKI_DIRECTORY_REALM=
WIKI_DIRECTORY_WIKI_CLIENT_UUID=
WIKI_DIRECTORY_CLIENT_ID=
WIKI_DIRECTORY_CLIENT_SECRET=
# Optional SMTP. Keep secrets in the external instance configuration only.
WIKI_MAIL_ENABLED=false
WIKI_MAIL_FROM=
WIKI_MAIL_HOST=
WIKI_MAIL_PORT=587
WIKI_MAIL_USERNAME=
WIKI_MAIL_PASSWORD=
WIKI_MAIL_AUTH=true
WIKI_MAIL_STARTTLS=true
