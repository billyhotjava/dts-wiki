#!/usr/bin/env python3
"""Read-only runtime permission and personal-MCP checks using external identity tokens."""
import argparse
import json
from pathlib import Path
import re
import sys
import urllib.parse

from acceptance_http import Client, ProbeFailure, external_token, origin_url, require


def validate_plan(document):
    require(isinstance(document, dict) and set(document) == {"identities"}, "Invalid acceptance plan")
    identities = document["identities"]
    require(isinstance(identities, list) and 1 <= len(identities) <= 20, "Provide 1 to 20 planned identities")
    labels = set()
    for identity in identities:
        require(isinstance(identity, dict) and set(identity) == {"label", "tokenEnv", "allow", "deny", "pages", "mcp"},
                "Identity plans contain labels and external token names, never token values")
        label = identity["label"]
        require(isinstance(label, str) and re.fullmatch(r"[A-Za-z0-9_.-]{1,64}", label) and label not in labels,
                "Use unique nonpersonal identity labels")
        labels.add(label)
        for key in ("allow", "deny"):
            slugs = identity[key]
            require(isinstance(slugs, list) and len(slugs) <= 200, "Invalid space matrix")
            require(all(isinstance(slug, str) and re.fullmatch(r"[a-z][a-z0-9-]{1,31}", slug) for slug in slugs),
                    "Invalid space slug")
            require(len(slugs) == len(set(slugs)), "Duplicate space slug")
        require(identity["allow"] and not set(identity["allow"]) & set(identity["deny"]), "Provide disjoint allowed/denied spaces")
        require(type(identity["mcp"]) is bool, "Declare whether personal MCP is included")
        pages = identity["pages"]
        require(isinstance(pages, list) and 1 <= len(pages) <= 20, "Provide authorized page samples")
        for page in pages:
            require(isinstance(page, dict) and set(page) == {"id", "space", "gitReadOnly"}, "Invalid page sample")
            require(type(page["id"]) is int and page["id"] > 0 and page["space"] in identity["allow"]
                    and type(page["gitReadOnly"]) is bool, "Page samples must belong to planned allowed spaces")
        external_token(identity["tokenEnv"])
    return identities


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", required=True)
    parser.add_argument("--management-url", help="Internal Kubernetes management origin; defaults to the application origin")
    scope = parser.add_mutually_exclusive_group(required=True)
    scope.add_argument("--plan", type=Path, help="Credential-free identity/space/page expectations")
    scope.add_argument("--public-only", action="store_true", help="Health/version/anonymous checks; identity acceptance remains GAP")
    parser.add_argument("--search", default="acceptance", help="Representative approved term; zero matches are allowed")
    parser.add_argument("--expected-commit", help="Require the deployed application Git commit, independently of health")
    args = parser.parse_args()
    checks = []
    try:
        origin = origin_url(args.base_url)
        management_origin = origin_url(args.management_url) if args.management_url else origin
        require(1 <= len(args.search.strip()) <= 200, "Invalid search term")
        require(args.expected_commit is None or re.fullmatch(r"[a-f0-9]{7,40}", args.expected_commit), "Invalid expected commit")
        identities = []
        if args.plan is not None:
            require(args.plan.stat().st_size <= 100_000, "Acceptance plan is too large")
            identities = validate_plan(json.loads(args.plan.read_text()))
    except (OSError, ValueError, TypeError, KeyError, ProbeFailure):
        print(json.dumps({"result": "GAP", "reason": "Invalid plan or missing external identity configuration"}))
        return 1

    def check(name, operation):
        try:
            operation()
            checks.append({"check": name, "result": "PASS"})
        except (ProbeFailure, ValueError, TypeError, KeyError, AttributeError):
            checks.append({"check": name, "result": "FAIL"})

    anonymous = Client(origin)
    management = Client(management_origin)
    for suffix in ("", "/readiness"):
        check("health" + suffix, lambda suffix=suffix: require(
            management.json("GET", "/management/health" + suffix).get("status") == "UP"))
    check("anonymous-api-rejected", lambda: require(anonymous.request("GET", "/api/wiki/spaces").status == 401))
    if args.expected_commit:
        def deployed_commit():
            info = management.json("GET", "/management/info")
            git = info.get("git", {})
            commit = git.get("commit", {}).get("id")
            if isinstance(commit, dict):
                require(not str(commit.get("describe", "")).endswith("-dirty"), "Dirty application build")
                commit = commit.get("full") or commit.get("abbrev")
            require(git.get("dirty") not in (True, "true"), "Dirty application build")
            require(isinstance(commit, str) and re.fullmatch(r"[a-f0-9]{7,40}", commit)
                    and commit.startswith(args.expected_commit), "Deployed commit mismatch")
        check("deployed-commit", deployed_commit)
    if args.public_only:
        passed = all(row["result"] == "PASS" for row in checks)
        print(json.dumps({"result": "PARTIAL" if passed else "FAIL", "mode": "publicOnly",
                          "identityAcceptance": "GAP", "checks": checks}, indent=2))
        return 0 if passed else 1
    for identity in identities:
        label = identity["label"]
        client = Client(origin, external_token(identity["tokenEnv"]))

        def inventory():
            rows = client.json("GET", "/api/wiki/spaces")
            require(isinstance(rows, list) and all(isinstance(row, dict) and isinstance(row.get("slug"), str) for row in rows))
            visible = {row["slug"] for row in rows}
            require(set(identity["allow"]) <= visible and not set(identity["deny"]) & visible)

        check(label + ":space-inventory", inventory)
        for allowed, slugs in ((True, identity["allow"]), (False, identity["deny"])):
            for slug in slugs:
                def access(slug=slug, allowed=allowed):
                    reply = client.request("GET", "/api/wiki/spaces/" + urllib.parse.quote(slug, safe=""))
                    require(reply.status == (200 if allowed else 404))
                    if allowed:
                        require(isinstance(reply.data, dict) and reply.data.get("slug") == slug)
                check(label + ":" + ("allow:" if allowed else "deny:") + slug, access)

        for sample in identity["pages"]:
            def page_read(sample=sample):
                page = client.json("GET", f"/api/wiki/pages/{sample['id']}")
                require(page.get("id") == sample["id"] and page.get("spaceSlug") == sample["space"]
                        and page.get("gitReadOnly") is sample["gitReadOnly"])
                if sample["gitReadOnly"]:
                    require(page.get("editable") is False)
                history = client.json("GET", f"/api/wiki/pages/{sample['id']}/versions?size=1")
                require(type(history.get("total")) is int and history["total"] > 0
                        and isinstance(history.get("items"), list) and history["items"])
                require(all(item.get("contentMd") is None for item in history["items"]))
            check(label + ":page-history:" + str(sample["id"]), page_read)

        def search_read():
            query = urllib.parse.urlencode({"q": args.search, "size": 20})
            result = client.json("GET", "/api/wiki/search?" + query)
            require(isinstance(result.get("items"), list) and type(result.get("total")) is int)
            require(all(item.get("spaceSlug") not in identity["deny"] for item in result["items"]))
        check(label + ":search-scope", search_read)

        if identity["mcp"]:
            def personal_mcp():
                headers = {"Accept": "application/json, text/event-stream", "MCP-Protocol-Version": "2025-11-25"}

                def rpc(method, params):
                    response = client.json("POST", "/mcp", {"jsonrpc": "2.0", "id": 1, "method": method, "params": params}, headers=headers)
                    require(response.get("jsonrpc") == "2.0" and response.get("id") == 1 and "error" not in response)
                    require(isinstance(response.get("result"), dict))
                    return response["result"]

                require(anonymous.request("POST", "/mcp", {}, headers).status == 401)
                initialized = rpc("initialize", {"protocolVersion": "2025-11-25", "capabilities": {},
                                                  "clientInfo": {"name": "wiki-acceptance", "version": "1"}})
                require(initialized.get("protocolVersion") == "2025-11-25")
                tools = rpc("tools/list", {})
                require(isinstance(tools.get("tools"), list))
                require({"wiki_search", "wiki_get_page"} <= {tool.get("name") for tool in tools["tools"]})
                sample = identity["pages"][0]
                read = rpc("tools/call", {"name": "wiki_get_page", "arguments": {"pageId": sample["id"]}})
                require(read.get("isError") is False)
                content = read.get("structuredContent")
                require(isinstance(content, dict) and content.get("id") == sample["id"] and content.get("spaceSlug") == sample["space"])
            check(label + ":personal-mcp", personal_mcp)

    passed = all(row["result"] == "PASS" for row in checks)
    print(json.dumps({"result": "PASS" if passed else "FAIL", "mode": "readOnly",
                      "personalMcpIncluded": any(identity["mcp"] for identity in identities), "checks": checks}, indent=2))
    return 0 if passed else 1


if __name__ == "__main__":
    sys.exit(main())
