{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuzhicloud.com/schemas/wiki/feature",
  "title": "Feature README frontmatter",
  "type": "object",
  "required": ["type", "id", "sprint", "title", "status"],
  "properties": {
    "type": { "const": "feature" },
    "id": { "type": "string", "pattern": "^S[0-9]+/F[0-9]+$" },
    "sprint": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY", "IN_PROGRESS", "DONE", "BLOCKED"] },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "owner": { "type": "string" }
  }
}
