{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuzhicloud.com/schemas/wiki/task",
  "title": "Task file frontmatter",
  "type": "object",
  "required": ["type", "id", "feature", "title", "status"],
  "properties": {
    "type": { "const": "task" },
    "id": { "type": "string", "pattern": "^S[0-9]+/F[0-9]+/T[0-9]{2}$" },
    "feature": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "enum": ["DRAFT", "READY", "IN_PROGRESS", "DONE", "BLOCKED"] },
    "priority": { "enum": ["P0", "P1", "P2"] },
    "owner": { "type": "string" },
    "depends": { "type": "array", "items": { "type": "string" } },
    "estimate": { "type": "string" },
    "blocked_reason": { "type": "string" }
  }
}
