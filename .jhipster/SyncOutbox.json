{
  "annotations": {
    "changelogDate": "20231211063226"
  },
  "applications": ["dtsWiki"],
  "documentation": "Outbound (wiki -> git) work item, written in the same transaction as the page change",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "op",
      "fieldType": "OutboxOp",
      "fieldValidateRules": ["required"],
      "fieldValues": "WRITE,MOVE,DELETE,RESTORE,ATTACH,DETACH"
    },
    {
      "documentation": "JSON: {fromPath,toPath,versionId,attachmentId,...}",
      "fieldName": "payload",
      "fieldType": "TextBlob",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "actorLogin",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "50"
    },
    {
      "fieldName": "actorName",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "fieldName": "actorEmail",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "254"
    },
    {
      "fieldName": "status",
      "fieldType": "OutboxStatus",
      "fieldValidateRules": ["required"],
      "fieldValues": "PENDING,DONE,FAILED,BLOCKED_BY_CONFLICT"
    },
    {
      "fieldName": "attempts",
      "fieldType": "Integer",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "lastError",
      "fieldType": "TextBlob"
    },
    {
      "fieldName": "createdAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "processedAt",
      "fieldType": "Instant"
    }
  ],
  "name": "SyncOutbox",
  "pagination": "pagination",
  "relationships": [
    {
      "otherEntityField": "slug",
      "otherEntityName": "space",
      "relationshipName": "space",
      "relationshipSide": "left",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    },
    {
      "otherEntityName": "page",
      "relationshipName": "page",
      "relationshipSide": "left",
      "relationshipType": "many-to-one"
    }
  ],
  "searchEngine": "no",
  "service": "serviceImpl"
}
