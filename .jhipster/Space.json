{
  "annotations": {
    "changelogDate": "20231211062426"
  },
  "applications": ["dtsWiki"],
  "documentation": "产品空间",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "slug",
      "fieldType": "String",
      "fieldValidateRules": ["required", "unique", "pattern"],
      "fieldValidateRulesPattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    {
      "fieldName": "name",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "40"
    },
    {
      "fieldName": "description",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "documentation": "SSH URL, e.g. git@github.com:billyhotjava/prs-stack.git ; null = no git sync",
      "fieldName": "gitRepoUrl",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "255"
    },
    {
      "fieldName": "gitBranch",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "fieldName": "position",
      "fieldType": "Integer"
    },
    {
      "fieldName": "archived",
      "fieldType": "Boolean",
      "fieldValidateRules": ["required"]
    }
  ],
  "name": "Space",
  "relationships": [
    {
      "otherEntityName": "syncRoot",
      "otherEntityRelationshipName": "space",
      "relationshipName": "syncRoots",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    },
    {
      "otherEntityName": "page",
      "otherEntityRelationshipName": "space",
      "relationshipName": "pages",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    }
  ],
  "searchEngine": "no",
  "service": "serviceImpl"
}
