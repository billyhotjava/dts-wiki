{
  "annotations": {
    "changelogDate": "20231211062826"
  },
  "applications": ["dtsWiki"],
  "documentation": "Immutable full-content snapshot of a page",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "versionNo",
      "fieldType": "Integer",
      "fieldValidateRules": ["required", "min"],
      "fieldValidateRulesMin": "1"
    },
    {
      "fieldName": "contentMd",
      "fieldType": "TextBlob",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "contentSha256",
      "fieldType": "String",
      "fieldValidateRules": ["required", "minlength", "maxlength"],
      "fieldValidateRulesMaxlength": "64",
      "fieldValidateRulesMinlength": "64"
    },
    {
      "documentation": "jhi_user login when authored in the wiki; git author name otherwise",
      "fieldName": "authorName",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "100"
    },
    {
      "fieldName": "authorEmail",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "254"
    },
    {
      "fieldName": "source",
      "fieldType": "VersionSource",
      "fieldValidateRules": ["required"],
      "fieldValues": "WEB,GIT,MERGE,RESTORE"
    },
    {
      "fieldName": "gitCommit",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "40"
    },
    {
      "fieldName": "message",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "500"
    },
    {
      "fieldName": "createdAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "PageVersion",
  "pagination": "pagination",
  "readOnly": true,
  "relationships": [
    {
      "otherEntityField": "login",
      "otherEntityName": "user",
      "relationshipName": "author",
      "relationshipSide": "left",
      "relationshipType": "many-to-one",
      "relationshipWithBuiltInEntity": true
    },
    {
      "otherEntityName": "page",
      "otherEntityRelationshipName": "versions",
      "relationshipName": "page",
      "relationshipSide": "right",
      "relationshipType": "many-to-one",
      "relationshipValidateRules": "required"
    }
  ],
  "searchEngine": "no",
  "service": "serviceImpl"
}
