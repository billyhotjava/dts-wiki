{
  "annotations": {
    "changelogDate": "20231211062726"
  },
  "applications": ["dtsWiki"],
  "documentation": "A node of the page tree",
  "dto": "mapstruct",
  "fields": [
    {
      "fieldName": "title",
      "fieldType": "String",
      "fieldValidateRules": ["required", "maxlength"],
      "fieldValidateRulesMaxlength": "200"
    },
    {
      "fieldName": "kind",
      "fieldType": "PageKind",
      "fieldValidateRules": ["required"],
      "fieldValues": "FOLDER,GIT,NATIVE,TEMPLATE"
    },
    {
      "documentation": "repository-relative path for GIT/FOLDER pages under a SyncRoot, e.g. worklog/v1.0.0/README.md",
      "fieldName": "gitPath",
      "fieldType": "String",
      "fieldValidateRules": ["maxlength"],
      "fieldValidateRulesMaxlength": "1024"
    },
    {
      "fieldName": "position",
      "fieldType": "Integer",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "syncStatus",
      "fieldType": "PageSyncStatus",
      "fieldValidateRules": ["required"],
      "fieldValues": "LOCAL_ONLY,SYNCED,PENDING_PUSH,CONFLICT"
    },
    {
      "fieldName": "createdAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "updatedAt",
      "fieldType": "Instant",
      "fieldValidateRules": ["required"]
    },
    {
      "fieldName": "deletedAt",
      "fieldType": "Instant"
    }
  ],
  "jpaMetamodelFiltering": true,
  "name": "Page",
  "pagination": "pagination",
  "relationships": [
    {
      "otherEntityName": "page",
      "otherEntityRelationshipName": "parent",
      "relationshipName": "children",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    },
    {
      "otherEntityName": "pageVersion",
      "otherEntityRelationshipName": "page",
      "relationshipName": "versions",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    },
    {
      "otherEntityName": "attachment",
      "otherEntityRelationshipName": "page",
      "relationshipName": "attachments",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    },
    {
      "otherEntityName": "comment",
      "otherEntityRelationshipName": "page",
      "relationshipName": "comments",
      "relationshipSide": "left",
      "relationshipType": "one-to-many"
    },
    {
      "otherEntityName": "pageVersion",
      "relationshipName": "currentVersion",
      "relationshipSide": "left",
      "relationshipType": "many-to-one"
    },
    {
      "otherEntityField": "name",
